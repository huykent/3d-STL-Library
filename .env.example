# PostgreSQL Configuration
POSTGRES_USER=stluser
POSTGRES_PASSWORD=stlpass
POSTGRES_DB=stl_library

# Telegram (Userbot) Configuration
# Get these from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_PHONE=+84xxxxxxxxxx
# Comma-separated list of group/channel IDs to monitor
TELEGRAM_CHAT_IDS=-100xxxxxxxxx,-100yyyyyyyyy

# Ollama Configuration
# Example: https://xxx.trycloudflare.com (if running on a remote Mac Mini via Cloudflare Tunnel)
# Or: http://host.docker.internal:11434 (if running locally on the host machine)
OLLAMA_BASE_URL=https://your-cloudflare-tunnel.trycloudflare.com
OLLAMA_MODEL=llama3.2:3b

# JWT Authentication
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
