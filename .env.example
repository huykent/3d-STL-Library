# ============================================================
# Database (PostgreSQL)
# In docker-compose, host is the service name "postgres"
# ============================================================
DATABASE_URL=postgresql+asyncpg://stluser:stlpass@postgres:5432/stl_library

# For local development (outside docker): replace "postgres" with "localhost"
# DATABASE_URL=postgresql+asyncpg://stluser:stlpass@localhost:5432/stl_library

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://redis:6379/0
# Local dev: REDIS_URL=redis://localhost:6379/0

# ============================================================
# Telegram Userbot (get from https://my.telegram.org)
# ============================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_PHONE=+84xxxxxxxxxx
TELEGRAM_SESSION_NAME=stl_crawler
# Comma-separated Telegram group/channel IDs (use negative numbers for groups)
TELEGRAM_CHAT_IDS=-100xxxxxxxxx,-100yyyyyyyyy

# ============================================================
# Ollama (Mac Mini M4 via Cloudflare Tunnel)
# ============================================================
OLLAMA_BASE_URL=https://your-tunnel-id.trycloudflare.com
OLLAMA_MODEL=llama3.2:3b

# ============================================================
# JWT Authentication
# Generate with: openssl rand -hex 32
# ============================================================
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# File Storage Paths (inside Docker container)
# ============================================================
THUMBNAIL_DIR=/app/thumbnails
TEMP_DIR=/app/temp

# ============================================================
# App Settings
# ============================================================
APP_ENV=development
LOG_LEVEL=INFO
